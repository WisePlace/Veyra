{
  "manifest_version": 3,
  "name": "Veyra Connect",
  "version": "1.2",
  "description": "Send your current Google session to the local Veyra app.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.google.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veyra Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
